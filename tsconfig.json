{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"module": "ES2022",
		"rootDir": ".",
		"moduleResolution": "bundler",
		"baseUrl": ".",
		"paths": {
			"@cache/*": ["src/cache/*"],
			"@config/*": ["src/config/*"],
			"@controllers/*": ["src/controllers/*"],
			"@models/*": ["src/models/*"],
			"@routes/*": ["src/routes/*"],
			"@services/*": ["src/services/*"],
			"@socket/*": ["src/socket/*"],
			"@utils/*": ["src/utils/*"],
			"@middlewares/*": ["src/middlewares/*"],
			"@command/*": ["src/command/*"],
			"@src/*": ["src/*"]
		},
		"sourceMap": false,
		"outDir": "dist",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true
	},
	"include": ["src/**/*", "test/**/*"],
	"exclude": ["node_modules", "dist"]
}
