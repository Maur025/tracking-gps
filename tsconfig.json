{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"module": "ES2022",
		"rootDir": "./src",
		"moduleResolution": "bundler",
		"baseUrl": "src",
		"paths": {
			"@models/*": ["models/*"],
			"@controllers/*": ["controllers/*"],
			"@services/*": ["services/*"],
			"@utils/*": ["utils/*"],
			"@middlewares/*": ["middlewares/*"],
			"@config/*": ["config/*"],
			"@routes/*": ["routes/*"],
			"@socket/*": ["socket/*"],
			"@cache/*": ["cache/*"],
			"@command/*": ["command/*"]
		},
		"sourceMap": false,
		"outDir": "dist",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,

		"strict": true,
		"skipLibCheck": true
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "test", "**/*.spec.ts", "**/*.test.ts", "dist"]
}
