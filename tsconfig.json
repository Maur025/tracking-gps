{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"module": "ES2022",
		"rootDir": ".",
		"moduleResolution": "node",
		"baseUrl": ".",
		"paths": {
			"@api-client/*": ["src/api-client/*"],
			"@app/*": ["src/app/*"],
			"@common/*": ["src/common/*"],
			"@config/*": ["src/config/*"],
			"@docs/*": ["src/docs/*"],
			"@routes/*": ["src/routes/*"],
			"@server/*": ["src/server/*"],
			"@socket/*": ["src/socket/*"],
			"@utils/*": ["src/utils/*"],
			"@src/*": ["src/*"]
		},
		"sourceMap": false,
		"outDir": "dist",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true
	},
	"include": ["src/**/*", "test/**/*"],
	"exclude": ["node_modules", "dist"]
}
